{
  "name": "@s2u/landing",
  "version": "0.5.0",
  "private": true,
  "description": "socomunzipped.com: the landing site of SOCOM Unzipped -- the scrolling page, the console menu, the story, the data page and the design-system gallery (Vite + TypeScript)",
  "license": "GPL-3.0",
  "type": "module",
  "scripts": {
    "dev": "node tools/prepare.mjs && vite",
    "prepare-inputs": "node tools/prepare.mjs",
    "build": "node tools/prepare.mjs --build && tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node tools/prepare.mjs && vitest run",
    "e2e": "playwright test",
    "e2e:update": "playwright test --update-snapshots",
    "lint": "eslint .",
    "assets": "python tools/build-assets.py"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.55.0",
    "eslint": "^10.1.0",
    "globals": "^17.4.0",
    "jsdom": "^29.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.2",
    "vite": "^8.0.3",
    "vitest": "^4.1.11"
  }
}

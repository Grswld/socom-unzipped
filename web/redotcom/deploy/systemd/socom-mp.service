# The no-Docker alternative. Install: see ../README.md "Without Docker".
#   /opt/socom-mp/server.mjs   the esbuild bundle        /etc/socom-mp.env   the environment (see ../env.example)
[Unit]
Description=SOCOM Unzipped multiplayer server
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=/etc/socom-mp.env
ExecStart=/usr/bin/node /opt/socom-mp/server.mjs
Restart=always
RestartSec=3
DynamicUser=yes
# Hardening. The disc directory (SOCOM_DISC in the env file) is only read.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=no
CapabilityBoundingSet=
SystemCallArchitectures=native
ReadOnlyPaths=/srv/socom-disc

[Install]
WantedBy=multi-user.target

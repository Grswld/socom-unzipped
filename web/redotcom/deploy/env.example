# The multiplayer server's settings. Copy to .env in this directory (`cp env.example .env`) and fill in the two
# required lines. .env is git-ignored and copied to the host by deploy.sh; never commit it.
# Placeholders only below: no real address, name or mail belongs in this file.

# --- Read by compose.yaml, the Caddyfile and deploy.sh ---

# REQUIRED. The public name Caddy serves and gets a certificate for (its DNS A record points at the host).
MP_DOMAIN=mp.example.com
# REQUIRED. The contact address given to Let's Encrypt for the certificate.
ACME_EMAIL=admin@example.com
# The host directory that holds the disc's RUN/ (mounted read-only into the container as /disc).
DISC_DIR=/srv/socom-disc

# --- Read by the server (packages/server/src/main.ts) ---

# The map stems a client may join, comma-separated (for example MP2,MP6); empty means all 22.
MAPS=
# The idle kick in milliseconds (W3.R13), held to 180000-300000.
IDLE_KICK_MS=240000
# The round length in seconds (W3.R11; the create-game default).
ROUND_SECONDS=360
# The rounds in a match (W3.R11: with respawn on, the original plays one).
MAX_ROUNDS=1

# --- Set by compose.yaml itself; only the no-Docker systemd unit (/etc/socom-mp.env) needs them ---

# The directory that holds RUN/ (compose sets /disc). Must match the unit's ReadOnlyPaths.
# SOCOM_DISC=/srv/socom-disc
# The address to bind (compose sets 0.0.0.0; behind a local Caddy use 127.0.0.1).
# HOST=127.0.0.1
# The HTTP/WebSocket port (compose sets 8787; 0 picks any free port).
# PORT=8787

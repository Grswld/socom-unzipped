// Sprint 17 F N1c, the real shapes (docs/research/82 section 9.7): entry states of last-bone 0x33c8 programs from the
// mission walk's refused capture (2026-09-30 15:58Z, PS2X_VU1_DUMP_REFUSED=logs/vu1refused1:2000:0x33c8), included by
// vu1_ops_tests.cpp inside its anonymous namespace. logs/ is not in the tree, so each capture is carried as the state
// its program reads: the register file whole (vi[16], vf[32] as bits), TOP, and the data qwords it loads -- q27-39,
// q327-355 (the template, the packet pointers, the colour quad, the list), q423, TOP..TOP+3, record [1] of every
// vertex (the repack rewrites [0], [2] and [1].zw) and the records past the end, the index records, the repack's
// staging source from q40 and, for a loop shape, the clipper's buffers q40-111 and the 150 staging q150-215. The
// test writes it over the fixture image vu1dump3_prog_31 (the same microcode, d418194495c25213).
//
// Faithful, checked when this file was written (a scratch differential, not in the tree): the interpreter over each
// real dump and over the fixture with this state written ends with the same register file, the same GIF packets
// (immediate model) and the same value in every qword either run stored, on the exact and the fast path. Each
// qword is 32 hex digits, the x, y, z, w words in that order.
struct RealDumpSpan
{
    uint32_t first; // the first qword of a run of consecutive qwords
    const char *hex;
};

struct RealDump
{
    const char *name; // the capture's file name, without .bin
    uint32_t top;
    int32_t vi[16];
    uint32_t vf[128];
    const RealDumpSpan *spans;
    size_t spanCount;
};


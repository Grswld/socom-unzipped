     void Iop::kprintf(CpuContext &c)
     {
-        // Only the format string; enough to follow what the drivers report.
-        std::string text = readString(arg(c, 0));
+        // ORACLE PATCH: render %d %i %u %x %X %c %s %p (flags and width skipped) from the o32 arguments, so
+        // "989snd Error: cause N" says which N.
+        const std::string format = readString(arg(c, 0));
+        std::string text;
+        unsigned next = 1;
+        for (size_t i = 0; i < format.size(); ++i)
+        {
+            if (format[i] != '%' || i + 1 >= format.size())
+            {
+                text.push_back(format[i]);
+                continue;
+            }
+            size_t j = i + 1;
+            while (j < format.size() && std::strchr("-+ #0123456789.lh", format[j]))
+                ++j;
+            if (j >= format.size())
+                break;
+            const char conv = format[j];
+            char buffer[32];
+            if (conv == '%')
+                text.push_back('%');
+            else if (conv == 's')
+                text += readString(arg(c, next++));
+            else if (conv == 'c')
+                text.push_back(static_cast<char>(arg(c, next++)));
+            else if (conv == 'd' || conv == 'i')
+            {
+                std::snprintf(buffer, sizeof buffer, "%d", static_cast<int32_t>(arg(c, next++)));
+                text += buffer;
+            }
+            else if (conv == 'u')
+            {
+                std::snprintf(buffer, sizeof buffer, "%u", arg(c, next++));
+                text += buffer;
+            }
+            else if (conv == 'x' || conv == 'X' || conv == 'p')
+            {
+                std::snprintf(buffer, sizeof buffer, "%x", arg(c, next++));
+                text += buffer;
+            }
+            else
+                text += format.substr(i, j - i + 1);
+            i = j;
+        }
         while (!text.empty() && (text.back() == '\n' || text.back() == '\r'))
             text.pop_back();
         if (!text.empty())
